    <dependencies>
    <!-- Microsoft JDBC Driver for SQL Server -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>13.4.0.jre11</version> <!-- Use jre8, jre11, or jre17 depending on your Java version -->
        </dependency>
    </dependencies>
</project>